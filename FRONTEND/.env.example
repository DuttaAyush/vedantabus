# ─────────────────────────────────────────────────────────────────
# VedantaBus / Vedanta Group Of Companies Customer Portal — Environment Configuration
# Copy this file to .env.local for local overrides.
# ─────────────────────────────────────────────────────────────────

# ── 1. App Port & URLs ────────────────────────────────────────────
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 2. Payment Gateway (Client-side keys for modal checkout) ──────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── 3. Maps & Bus Tracking (Future Setup) ─────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ── 4. Analytics & Monitoring (Future Setup) ──────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=

# ── 5. Media CDN / External Assets ────────────────────────────────
NEXT_PUBLIC_CDN_BASE_URL=
