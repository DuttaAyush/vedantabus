# ─────────────────────────────────────────────────────────────────
# VedantaBus / Vedanta Group Of Companies Admin Portal — Environment Configuration
# Copy this file to .env.local for local overrides.
# ─────────────────────────────────────────────────────────────────

# ── 1. App Port & URLs ────────────────────────────────────────────
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ── 2. Route Management & Maps (Future Setup) ─────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ── 3. Bus Fleet & Media Uploads (Future Setup) ───────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── 4. Error Tracking & Monitoring (Future Setup) ─────────────────
NEXT_PUBLIC_SENTRY_DSN=
